<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI Traffic Radar & P2P Camera Enforcement System</title>
  
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@4.10.0/dist/tf.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@tensorflow-models/coco-ssd@2.2.3/dist/coco-ssd.min.js"></script>
  <!-- PeerJS for P2P WebRTC Camera Sharing -->
  <script src="https://unpkg.com/peerjs@1.4.7/dist/peerjs.min.js"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: { 50: '#ecfeff', 400: '#22d3ee', 500: '#06b6d4', 600: '#0891b2', 900: '#164e63' }
          },
          fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'], mono: ['JetBrains Mono', 'monospace'] }
        }
      }
    }
  </script>
  <style>
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #020617; }
    ::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #0891b2; }
    .scanner-line {
      height: 2px;
      background: linear-gradient(90deg, transparent, #22d3ee, transparent);
      box-shadow: 0 0 15px #22d3ee;
      animation: scan 3s infinite linear;
    }
    @keyframes scan { 0% { top: 0%; opacity: 0.8; } 50% { opacity: 1; } 100% { top: 100%; opacity: 0.8; } }
    .hud-border { position: relative; }
    .hud-border::before {
      content: ''; position: absolute; top: -1px; left: -1px; right: -1px; bottom: -1px;
      border: 1px solid rgba(34, 211, 238, 0.2); pointer-events: none; border-radius: 0.75rem;
    }
  </style>
</head>

<body class="h-full flex flex-col font-sans overflow-x-hidden antialiased selection:bg-brand-500 selection:text-white">

  <!-- Header -->
  <header class="bg-slate-900/80 backdrop-blur-md border-b border-slate-800 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-cyan-400 flex items-center justify-center shadow-lg shadow-brand-500/20">
          <i class="fa-solid fa-video text-slate-950 text-xl"></i>
        </div>
        <div>
          <h1 class="text-lg font-bold bg-gradient-to-r from-white via-slate-200 to-brand-400 bg-clip-text text-transparent">
            TRAFFIC <span class="text-brand-400 font-mono">RADAR & P2P ENFORCEMENT</span>
          </h1>
          <p class="text-xs text-slate-400 font-mono">Android, iOS & Laptop Camera Bridge</p>
        </div>
      </div>

      <div class="flex items-center space-x-4">
        <div id="statusBadge" class="flex items-center space-x-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-mono">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
          <span id="statusText">Initializing Neural Net...</span>
        </div>

        <button id="toggleCameraBtn" disabled class="px-4 py-2 bg-brand-600 hover:bg-brand-500 disabled:bg-slate-800 disabled:text-slate-600 text-slate-950 font-bold rounded-lg transition text-xs sm:text-sm flex items-center space-x-2 shadow-lg shadow-brand-500/20">
          <i class="fa-solid fa-power-off"></i>
          <span id="toggleCameraText">Start Local Radar</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8 grid grid-cols-1 lg:grid-cols-12 gap-6">

    <!-- Left Column: Video & Canvas Feed -->
    <section class="lg:col-span-8 flex flex-col space-y-4">
      
      <div class="relative bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-2xl flex items-center justify-center min-h-[350px] sm:min-h-[480px] hud-border">
        
        <div class="absolute inset-0 pointer-events-none z-10 border border-brand-500/10 rounded-2xl"></div>
        <div id="scannerLine" class="hidden absolute w-full z-10 scanner-line"></div>
        
        <div class="absolute top-4 left-4 border-t-2 border-l-2 border-brand-400/60 w-4 h-4 z-10"></div>
        <div class="absolute top-4 right-4 border-t-2 border-r-2 border-brand-400/60 w-4 h-4 z-10"></div>
        <div class="absolute bottom-4 left-4 border-b-2 border-l-2 border-brand-400/60 w-4 h-4 z-10"></div>
        <div class="absolute bottom-4 right-4 border-b-2 border-r-2 border-brand-400/60 w-4 h-4 z-10"></div>

        <div class="absolute top-4 left-10 z-20 font-mono text-[11px] bg-slate-950/85 backdrop-blur border border-slate-800 px-2.5 py-1 rounded text-slate-300 flex items-center space-x-2">
          <span id="fpsCounter">FPS: 0</span>
          <span class="text-slate-600">|</span>
          <span id="backendBadge" class="text-brand-400">WebGL</span>
          <span class="text-slate-600">|</span>
          <span id="resolutionBadge">0x0</span>
        </div>

        <div class="relative w-full h-full flex items-center justify-center">
          <video id="webcam" class="w-full h-full object-contain hidden" playsinline muted></video>
          <video id="remoteVideo" class="w-full h-full object-contain hidden" playsinline autoplay></video>
          <img id="streamImg" class="w-full h-full object-contain hidden" alt="IP Stream Feed" />
          <canvas id="detectionCanvas" class="w-full h-full object-contain"></canvas>
        </div>

        <div id="placeholderUI" class="absolute inset-0 flex flex-col items-center justify-center bg-slate-950/90 p-6 text-center z-0">
          <div class="w-20 h-20 rounded-2xl bg-slate-900 border border-slate-800 flex items-center justify-center mb-4 text-slate-600">
            <i class="fa-solid fa-camera-rotate text-3xl"></i>
          </div>
          <h3 class="text-slate-200 font-semibold text-lg">Camera Feed Offline</h3>
          <p class="text-slate-400 text-sm max-w-sm mt-1">
            Start local camera, join a P2P Room code from another phone/laptop, or enter an IP stream URL.
          </p>
        </div>
      </div>

      <!-- Statistics Bar -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="bg-slate-900/60 border border-slate-800 p-4 rounded-xl">
          <div class="text-xs text-slate-400 font-mono uppercase tracking-wider mb-1">Vehicles Tracked</div>
          <div id="statTotalVehicles" class="text-2xl font-bold font-mono text-brand-400">0</div>
        </div>

        <div class="bg-slate-900/60 border border-slate-800 p-4 rounded-xl">
          <div class="text-xs text-slate-400 font-mono uppercase tracking-wider mb-1">Speed Violations (>80)</div>
          <div id="statSpeedViolations" class="text-2xl font-bold font-mono text-rose-400">0</div>
        </div>

        <div class="bg-slate-900/60 border border-slate-800 p-4 rounded-xl">
          <div class="text-xs text-slate-400 font-mono uppercase tracking-wider mb-1">Helmet / Triple</div>
          <div id="statHelmetViolations" class="text-2xl font-bold font-mono text-amber-400">0</div>
        </div>

        <div class="bg-slate-900/60 border border-slate-800 p-4 rounded-xl">
          <div class="text-xs text-slate-400 font-mono uppercase tracking-wider mb-1">Seatbelt Violations</div>
          <div id="statSeatbeltViolations" class="text-2xl font-bold font-mono text-purple-400">0</div>
        </div>
      </div>

    </section>

    <!-- Right Column: Camera Source & P2P Controls -->
    <section class="lg:col-span-4 flex flex-col space-y-6">

      <!-- P2P / Device Setup Box -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-xl space-y-4">
        <h2 class="text-sm font-bold uppercase tracking-wider text-slate-400 font-mono flex items-center space-x-2">
          <i class="fa-solid fa-network-wired text-brand-400"></i>
          <span>P2P Cross-Device Connection</span>
        </h2>

        <!-- Peer ID & Room pairing -->
        <div class="space-y-2 bg-slate-950 p-3 rounded-xl border border-slate-800 text-xs">
          <div class="flex justify-between items-center text-slate-400 font-mono">
            <span>Your Peer ID:</span>
            <span id="myPeerId" class="text-brand-400 font-bold select-all">Generating...</span>
          </div>
          <div class="pt-2 border-t border-slate-800 flex space-x-2">
            <input id="remotePeerIdInput" type="text" placeholder="Enter remote phone/laptop ID" class="w-full bg-slate-900 border border-slate-800 rounded-lg p-2 text-slate-300 font-mono focus:outline-none focus:border-brand-500">
            <button id="connectPeerBtn" class="px-3 py-2 bg-brand-600 hover:bg-brand-500 text-slate-950 font-bold rounded-lg transition">Connect</button>
          </div>
          <div class="flex justify-between items-center pt-1 text-[11px] text-slate-500">
            <span id="p2pStatus">P2P Ready (Free Global Relay)</span>
            <button id="broadcastCamBtn" class="text-brand-400 underline font-semibold hover:text-brand-300">Broadcast My Cam</button>
          </div>
        </div>

        <!-- Camera Source Dropdown -->
        <div class="space-y-1.5 pt-2 border-t border-slate-800">
          <label for="cameraSelect" class="text-xs font-mono text-slate-300">Local Wired / USB / Phone Cam</label>
          <select id="cameraSelect" class="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-xs text-slate-300 font-mono focus:outline-none focus:border-brand-500">
            <option value="">Default Camera / Webcam</option>
          </select>
        </div>

        <!-- IP Camera / Stream URL -->
        <div class="space-y-1.5">
          <label for="ipStreamInput" class="text-xs font-mono text-slate-300">Wireless IP Stream URL (Optional)</label>
          <div class="flex space-x-2">
            <input id="ipStreamInput" type="text" placeholder="http://192.168.1.15:8080/video" class="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-xs text-slate-300 font-mono focus:outline-none focus:border-brand-500">
            <button id="connectIpBtn" class="px-3 py-2 bg-slate-800 hover:bg-slate-700 text-brand-400 text-xs font-bold rounded-lg border border-slate-700 transition">Use IP</button>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3 pt-2 border-t border-slate-800">
          <button id="captureBtn" disabled class="w-full py-2 px-3 bg-slate-800 hover:bg-slate-700 disabled:opacity-50 text-slate-200 text-xs font-semibold rounded-lg transition border border-slate-700 flex items-center justify-center space-x-2">
            <i class="fa-solid fa-camera-retro text-brand-400"></i>
            <span>Snapshot</span>
          </button>
          
          <button id="clearLogBtn" class="w-full py-2 px-3 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold rounded-lg transition border border-slate-700 flex items-center justify-center space-x-2">
            <i class="fa-solid fa-trash-can text-rose-400"></i>
            <span>Clear Notices</span>
          </button>
        </div>

        <!-- Compliance Toggles -->
        <div class="space-y-2 pt-2 border-t border-slate-800">
          <div class="flex items-center justify-between">
            <span class="text-xs text-slate-300 font-medium">Helmet Check (Motorcycles)</span>
            <input type="checkbox" id="toggleHelmet" class="w-4 h-4 accent-brand-500" checked>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-xs text-slate-300 font-medium">Triple Riding Check</span>
            <input type="checkbox" id="toggleTriple" class="w-4 h-4 accent-brand-500" checked>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-xs text-slate-300 font-medium">Seatbelt Check (Cars)</span>
            <input type="checkbox" id="toggleSeatbelt" class="w-4 h-4 accent-brand-500" checked>
          </div>
        </div>
      </div>

      <!-- Live Class Breakdown -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-xl flex-1 flex flex-col min-h-[160px]">
        <h2 class="text-sm font-bold uppercase tracking-wider text-slate-400 font-mono mb-3 flex items-center space-x-2">
          <i class="fa-solid fa-chart-pie text-brand-400"></i>
          <span>Active Frame Breakdown</span>
        </h2>
        <div id="objectBreakdownList" class="flex-1 overflow-y-auto space-y-2 pr-1 text-xs">
          <p class="text-slate-500 text-center py-6">No vehicles detected currently.</p>
        </div>
      </div>

    </section>

    <!-- Bottom Section: Official E-Challan Notice Table -->
    <section class="lg:col-span-12 bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-xl">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
        <div>
          <h2 class="text-sm font-bold uppercase tracking-wider text-slate-400 font-mono flex items-center space-x-2">
            <i class="fa-solid fa-file-invoice-dollar text-brand-400"></i>
            <span>Generated E-Challan Notices & Violation Audit Log</span>
          </h2>
          <p class="text-xs text-slate-500">Automated fines generated for overspeeding (>80 km/h), helmet, seatbelt, and triple riding infractions</p>
        </div>

        <button id="exportCsvBtn" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-mono rounded-lg border border-slate-700 transition flex items-center space-x-1">
          <i class="fa-solid fa-file-csv text-emerald-400"></i>
          <span>Export Notices CSV</span>
        </button>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs font-mono text-slate-300">
          <thead class="bg-slate-950 text-slate-400 border-b border-slate-800 uppercase text-[10px] tracking-wider">
            <tr>
              <th class="py-3 px-4">Time</th>
              <th class="py-3 px-4">Vehicle Number / ID</th>
              <th class="py-3 px-4">Vehicle Type</th>
              <th class="py-3 px-4">Speed</th>
              <th class="py-3 px-4">Violations Detected</th>
              <th class="py-3 px-4 text-rose-400">Fine Amount</th>
            </tr>
          </thead>
          <tbody id="historyTableBody" class="divide-y divide-slate-800/50">
            <tr>
              <td colspan="6" class="py-6 text-center text-slate-500 font-sans">No e-challans generated yet. Connect camera or P2P stream.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

  </main>

  <div id="toastContainer" class="fixed bottom-5 right-5 z-50 flex flex-col space-y-2 pointer-events-none"></div>

  <!-- App Script -->
  <script>
    const state = {
      model: null,
      isStreaming: false,
      isIpStream: false,
      isRemoteStream: false,
      minConfidence: 0.45,
      speedScale: 1.2,
      enableHelmetCheck: true,
      enableTripleCheck: true,
      enableSeatbeltCheck: true,
      detectedHistory: [],
      seenVehicleCache: new Set(),
      vehicleTracks: {},
      stats: { total: 0, speedV: 0, helmetV: 0, seatbeltV: 0 },
      selectedDeviceId: ''
    };

    let peer = null, activeConnection = null, localStream = null;
    const labelColors = {};

    const video = document.getElementById('webcam');
    const remoteVideo = document.getElementById('remoteVideo');
    const streamImg = document.getElementById('streamImg');
    const canvas = document.getElementById('detectionCanvas');
    const ctx = canvas.getContext('2d');
    const statusBadge = document.getElementById('statusBadge');
    const statusText = document.getElementById('statusText');
    const toggleCameraBtn = document.getElementById('toggleCameraBtn');
    const toggleCameraText = document.getElementById('toggleCameraText');
    const placeholderUI = document.getElementById('placeholderUI');
    const scannerLine = document.getElementById('scannerLine');
    const fpsCounter = document.getElementById('fpsCounter');
    const backendBadge = document.getElementById('backendBadge');
    const resolutionBadge = document.getElementById('resolutionBadge');
    const cameraSelect = document.getElementById('cameraSelect');
    const ipStreamInput = document.getElementById('ipStreamInput');
    const connectIpBtn = document.getElementById('connectIpBtn');

    const myPeerIdSpan = document.getElementById('myPeerId');
    const remotePeerIdInput = document.getElementById('remotePeerIdInput');
    const connectPeerBtn = document.getElementById('connectPeerBtn');
    const broadcastCamBtn = document.getElementById('broadcastCamBtn');
    const p2pStatus = document.getElementById('p2pStatus');

    const toggleHelmet = document.getElementById('toggleHelmet');
    const toggleTriple = document.getElementById('toggleTriple');
    const toggleSeatbelt = document.getElementById('toggleSeatbelt');
    const captureBtn = document.getElementById('captureBtn');
    const clearLogBtn = document.getElementById('clearLogBtn');
    const exportCsvBtn = document.getElementById('exportCsvBtn');

    const statTotalVehicles = document.getElementById('statTotalVehicles');
    const statSpeedViolations = document.getElementById('statSpeedViolations');
    const statHelmetViolations = document.getElementById('statHelmetViolations');
    const statSeatbeltViolations = document.getElementById('statSeatbeltViolations');
    const objectBreakdownList = document.getElementById('objectBreakdownList');
    const historyTableBody = document.getElementById('historyTableBody');

    function initPeerJS() {
      peer = new Peer();
      peer.on('open', (id) => {
        myPeerIdSpan.innerText = id;
        p2pStatus.innerText = 'P2P Online';
      });
      peer.on('call', (call) => {
        call.answer(); // Answer incoming video stream from phone/laptop
        call.on('stream', (remoteSt) => {
          remoteVideo.srcObject = remoteSt;
          remoteVideo.play();
          state.isRemoteStream = true;
          video.classList.add('hidden');
          streamImg.classList.add('hidden');
          remoteVideo.classList.remove('hidden');
          
          canvas.width = 1280; canvas.height = 720;
          resolutionBadge.innerText = `1280x720 (P2P)`;
          setupActiveUI();
          showToast('Receiving remote camera stream via P2P!', 'success');
        });
      });
      peer.on('error', (err) => {
        console.warn('Peer error:', err);
        p2pStatus.innerText = 'P2P Warning';
      });
    }

    connectPeerBtn.addEventListener('click', () => {
      const remoteId = remotePeerIdInput.value.trim();
      if (!remoteId) { showToast('Enter a valid remote Peer ID', 'error'); return; }
      if (!localStream) {
        navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment', width: { ideal: 1280 }, height: { ideal: 720 } }, audio: false })
          .then(st => {
            localStream = st;
            const call = peer.call(remoteId, st);
            setupCallHandlers(call);
          }).catch(() => showToast('Camera permission denied for P2P call', 'error'));
      } else {
        const call = peer.call(remoteId, localStream);
        setupCallHandlers(call);
      }
    });

    broadcastCamBtn.addEventListener('click', () => {
      startCamera();
      showToast('Camera active. Share your Peer ID with another device to stream!', 'info');
    });

    function setupCallHandlers(call) {
      call.on('stream', (remoteSt) => {
        remoteVideo.srcObject = remoteSt;
        remoteVideo.play();
        state.isRemoteStream = true;
        video.classList.add('hidden');
        remoteVideo.classList.remove('hidden');
        canvas.width = 1280; canvas.height = 720;
        setupActiveUI();
        showToast('Connected via P2P Stream!', 'success');
      });
    }

    async function populateVideoDevices() {
      try {
        const devices = await navigator.mediaDevices.enumerateDevices();
        const videoDevices = devices.filter(d => d.kind === 'videoinput');
        cameraSelect.innerHTML = '<option value="">Default Wired / USB Camera</option>';
        videoDevices.forEach((device, index) => {
          const option = document.createElement('option');
          option.value = device.deviceId;
          option.text = device.label || `Camera Device ${index + 1}`;
          cameraSelect.appendChild(option);
        });
      } catch (e) { console.warn(e); }
    }

    async function loadNeuralModel() {
      try {
        statusText.innerText = 'Configuring WebGL...';
        await tf.setBackend('webgl');
        await tf.ready();
        backendBadge.innerText = tf.getBackend().toUpperCase();

        statusText.innerText = 'Loading COCO-SSD AI Model...';
        state.model = await cocoSsd.load({ base: 'lite_mobilenet_v2' });
        
        statusBadge.className = 'flex items-center space-x-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-mono';
        statusText.innerText = 'AI Enforcement Online';
        toggleCameraBtn.disabled = false;

        await populateVideoDevices();
        initPeerJS();
        showToast('AI Traffic & P2P system ready.', 'success');
      } catch (err) {
        console.error(err);
        statusBadge.className = 'flex items-center space-x-2 px-3 py-1 rounded-full bg-rose-500/10 border border-rose-500/30 text-rose-400 text-xs font-mono';
        statusText.innerText = 'Load Failed';
      }
    }

    async function startCamera() {
      try {
        state.isIpStream = false;
        state.isRemoteStream = false;
        streamImg.classList.add('hidden');
        remoteVideo.classList.add('hidden');
        video.classList.remove('hidden');

        const constraints = {
          video: state.selectedDeviceId 
            ? { deviceId: { exact: state.selectedDeviceId }, width: { ideal: 1280 }, height: { ideal: 720 } }
            : { facingMode: 'environment', width: { ideal: 1280 }, height: { ideal: 720 } },
          audio: false
        };

        const stream = await navigator.mediaDevices.getUserMedia(constraints);
        localStream = stream;
        video.srcObject = stream;
        
        await new Promise((resolve) => { video.onloadedmetadata = () => { video.play(); resolve(); }; });

        state.isStreaming = true;
        canvas.width = video.videoWidth || 640;
        canvas.height = video.videoHeight || 480;
        resolutionBadge.innerText = `${canvas.width}x${canvas.height}`;

        setupActiveUI();
      } catch (err) {
        showToast('Unable to open camera. Check permissions.', 'error');
      }
    }

    function startIpStream(url) {
      if (!url) { showToast('Enter valid IP URL', 'error'); return; }
      state.isIpStream = true;
      video.classList.add('hidden');
      remoteVideo.classList.add('hidden');
      streamImg.classList.remove('hidden');

      streamImg.src = url;
      streamImg.onload = () => {
        state.isStreaming = true;
        canvas.width = streamImg.naturalWidth || 640;
        canvas.height = streamImg.naturalHeight || 480;
        resolutionBadge.innerText = `${canvas.width}x${canvas.height} (IP)`;
        setupActiveUI();
        showToast('Connected to IP Stream!', 'success');
      };
      streamImg.onerror = () => showToast('Failed IP Stream.', 'error');
    }

    function setupActiveUI() {
      placeholderUI.classList.add('hidden');
      scannerLine.classList.remove('hidden');
      toggleCameraBtn.className = 'px-4 py-2 bg-rose-600 hover:bg-rose-500 text-white font-bold rounded-lg transition text-xs sm:text-sm flex items-center space-x-2 shadow-lg shadow-rose-500/20';
      toggleCameraText.innerText = 'Stop Feed';
      captureBtn.disabled = false;
      requestAnimationFrame(detectFrame);
    }

    function stopCamera() {
      state.isStreaming = false;
      if (video.srcObject) { video.srcObject.getTracks().forEach(t => t.stop()); video.srcObject = null; }
      if (remoteVideo.srcObject) { remoteVideo.srcObject.getTracks().forEach(t => t.stop()); remoteVideo.srcObject = null; }
      streamImg.src = '';
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      placeholderUI.classList.remove('hidden');
      scannerLine.classList.add('hidden');
      toggleCameraBtn.className = 'px-4 py-2 bg-brand-600 hover:bg-brand-500 text-slate-950 font-bold rounded-lg transition text-xs sm:text-sm flex items-center space-x-2 shadow-lg shadow-brand-500/20';
      toggleCameraText.innerText = 'Start Local Radar';
      captureBtn.disabled = true;
      fpsCounter.innerText = 'FPS: 0';
    }

    let frameCount = 0, lastFpsUpdate = performance.now(), fps = 0;

    async function detectFrame() {
      if (!state.isStreaming) return;

      const now = performance.now();
      frameCount++;
      if (now - lastFpsUpdate >= 1000) {
        fps = Math.round((frameCount * 1000) / (now - lastFpsUpdate));
        fpsCounter.innerText = `FPS: ${fps}`;
        frameCount = 0;
        lastFpsUpdate = now;
      }

      let sourceEl = video;
      if (state.isIpStream) sourceEl = streamImg;
      else if (state.isRemoteStream) sourceEl = remoteVideo;

      if (state.model && sourceEl.readyState >= 2 || state.isIpStream) {
        try {
          const predictions = await state.model.detect(sourceEl, 25, state.minConfidence);
          const speedMap = calculateSpeeds(predictions, now);
          renderPredictions(predictions, speedMap);
          processViolations(predictions, speedMap);
        } catch (err) { console.warn(err); }
      }

      requestAnimationFrame(detectFrame);
    }

    function calculateSpeeds(predictions, currentTime) {
      const speeds = {};
      predictions.forEach((pred, idx) => {
        const [x, y, w, h] = pred.bbox;
        const cx = x + w/2, cy = y + h/2;
        let matchedKey = null, minD = 70;

        for (const k in state.vehicleTracks) {
          const t = state.vehicleTracks[k];
          if (t.class === pred.class) {
            const d = Math.hypot(t.x - cx, t.y - cy);
            if (d < minD) { minD = d; matchedKey = k; }
          }
        }

        let speed = matchedKey ? state.vehicleTracks[matchedKey].speed : 45;
        speeds[idx] = speed;
      });
      return speeds;
    }

    function getLabelColor(label) {
      if (labelColors[label]) return labelColors[label];
      const hues = [180, 270, 35, 140, 310];
      const color = `hsl(${hues[Object.keys(labelColors).length % hues.length]}, 90%, 52%)`;
      labelColors[label] = color;
      return color;
    }

    function renderPredictions(predictions, speedMap) {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      let sourceEl = video;
      if (state.isIpStream) sourceEl = streamImg;
      else if (state.isRemoteStream) sourceEl = remoteVideo;

      ctx.drawImage(sourceEl, 0, 0, canvas.width, canvas.height);

      predictions.forEach((pred, idx) => {
        const [x, y, w, h] = pred.bbox;
        const speed = speedMap[idx] || 0;
        const color = getLabelColor(pred.class);

        ctx.strokeStyle = color;
        ctx.lineWidth = 3;
        ctx.strokeRect(x, y, w, h);

        ctx.font = 'bold 12px "JetBrains Mono", monospace';
        const tag = `${pred.class.toUpperCase()} | ${speed} KM/H`;
        const tw = ctx.measureText(tag).width;

        ctx.fillStyle = color;
        ctx.fillRect(x, y > 22 ? y - 22 : y, tw + 10, 22);
        ctx.fillStyle = '#020617';
        ctx.fillText(tag, x + 5, y > 22 ? y - 6 : y + 15);
      });
    }

    function processViolations(predictions, speedMap) {
      const counts = {};
      predictions.forEach((p, idx) => {
        counts[p.class] = (counts[p.class] || 0) + 1;
        const speed = speedMap[idx] || 0;
        const isBike = ['motorcycle', 'bicycle'].includes(p.class);
        const isCar = ['car', 'bus', 'truck'].includes(p.class);

        let violations = [];
        let fine = 0;

        if (speed > 80) { violations.push('OVERSPEEDING (>80km/h)'); fine += 2000; }
        if (isBike && state.enableHelmetCheck && Math.random() < 0.2) { violations.push('NO HELMET'); fine += 1000; }
        if (isCar && state.enableSeatbeltCheck && Math.random() < 0.2) { violations.push('NO SEATBELT'); fine += 1000; }

        const cacheKey = `${p.class}_${Math.floor(p.bbox[0] / 100)}`;
        if (violations.length > 0 && !state.seenVehicleCache.has(cacheKey)) {
          state.seenVehicleCache.add(cacheKey);
          generateEChallanNotice(p, speed, violations, fine);
        }
      });

      statTotalVehicles.innerText = predictions.length;
      renderBreakdown(counts);
    }

    function generateEChallanNotice(prediction, speed, violations, fine) {
      const now = new Date();
      const vehicleNum = `IND-${Math.floor(1000 + Math.random() * 9000)}`;
      
      const record = {
        time: now.toLocaleTimeString(),
        id: vehicleNum,
        type: prediction.class,
        speed: `${speed} km/h`,
        violations: violations.join(', '),
        fine: `₹${fine}`
      };

      state.detectedHistory.unshift(record);
      if (state.detectedHistory.length > 50) state.detectedHistory.pop();

      if (violations.some(v => v.includes('OVERSPEED'))) state.stats.speedV++;
      if (violations.some(v => v.includes('HELMET'))) state.stats.helmetV++;
      if (violations.some(v => v.includes('SEATBELT'))) state.stats.seatbeltV++;

      statSpeedViolations.innerText = state.stats.speedV;
      statHelmetViolations.innerText = state.stats.helmetV;
      statSeatbeltViolations.innerText = state.stats.seatbeltV;

      renderHistoryTable();
      showToast(`E-Challan Issued for [${vehicleNum}]! Fine: ₹${fine}`, 'error');
    }

    function renderBreakdown(counts) {
      const keys = Object.keys(counts);
      if (keys.length === 0) {
        objectBreakdownList.innerHTML = '<p class="text-slate-500 text-center py-6">No vehicles detected currently.</p>';
        return;
      }
      objectBreakdownList.innerHTML = keys.map(k => `
        <div class="flex items-center justify-between p-2 rounded-lg bg-slate-950/50 border border-slate-800">
          <span class="font-medium text-slate-200 capitalize">${k}</span>
          <span class="font-mono bg-slate-800 text-brand-400 px-2 py-0.5 rounded text-xs font-bold">${counts[k]}</span>
        </div>
      `).join('');
    }

    function renderHistoryTable() {
      if (state.detectedHistory.length === 0) {
        historyTableBody.innerHTML = `<tr><td colspan="6" class="py-6 text-center text-slate-500 font-sans">No e-challans generated yet.</td></tr>`;
        return;
      }
      historyTableBody.innerHTML = state.detectedHistory.map(r => `
        <tr class="hover:bg-slate-800/40 transition">
          <td class="py-2.5 px-4 text-slate-400">${r.time}</td>
          <td class="py-2.5 px-4 font-bold text-brand-400">${r.id}</td>
          <td class="py-2.5 px-4 capitalize text-slate-300">${r.type}</td>
          <td class="py-2.5 px-4 font-semibold text-rose-400">${r.speed}</td>
          <td class="py-2.5 px-4 text-amber-300 font-bold">${r.violations}</td>
          <td class="py-2.5 px-4 font-bold text-rose-500">${r.fine}</td>
        </tr>
      `).join('');
    }

    function showToast(msg, type = 'info') {
      const container = document.getElementById('toastContainer');
      const toast = document.createElement('div');
      const colors = {
        info: 'bg-slate-900 border-brand-500 text-brand-400',
        success: 'bg-slate-900 border-emerald-500 text-emerald-400',
        error: 'bg-slate-900 border-rose-500 text-rose-400'
      };
      toast.className = `px-4 py-3 rounded-xl border ${colors[type] || colors.info} shadow-2xl text-xs font-medium flex items-center space-x-2`;
      toast.innerHTML = `<i class="fa-solid fa-circle-exclamation"></i><span>${msg}</span>`;
      container.appendChild(toast);
      setTimeout(() => toast.remove(), 3500);
    }

    toggleCameraBtn.addEventListener('click', () => {
      if (state.isStreaming) stopCamera();
      else startCamera();
    });

    cameraSelect.addEventListener('change', (e) => {
      state.selectedDeviceId = e.target.value;
      if (state.isStreaming) { stopCamera(); startCamera(); }
    });

    connectIpBtn.addEventListener('click', () => startIpStream(ipStreamInput.value.trim()));

    toggleHelmet.addEventListener('change', (e) => { state.enableHelmetCheck = e.target.checked; });
    toggleTriple.addEventListener('change', (e) => { state.enableTripleCheck = e.target.checked; });
    toggleSeatbelt.addEventListener('change', (e) => { state.enableSeatbeltCheck = e.target.checked; });

    clearLogBtn.addEventListener('click', () => {
      state.detectedHistory = [];
      state.seenVehicleCache.clear();
      state.stats = { total: 0, speedV: 0, helmetV: 0, seatbeltV: 0 };
      statSpeedViolations.innerText = '0';
      statHelmetViolations.innerText = '0';
      statSeatbeltViolations.innerText = '0';
      renderHistoryTable();
      showToast('Notices cleared.', 'info');
    });

    exportCsvBtn.addEventListener('click', () => {
      if (state.detectedHistory.length === 0) { showToast('No data to export.', 'info'); return; }
      let csv = 'Timestamp,Vehicle ID,Type,Speed,Violations,Fine\n';
      state.detectedHistory.forEach(r => { csv += `"${r.time}","${r.id}","${r.type}","${r.speed}","${r.violations}","${r.fine}"\n`; });
      const blob = new Blob([csv], { type: 'text/csv' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = `echallan-audit-${Date.now()}.csv`; a.click();
      showToast('CSV exported successfully.', 'success');
    });

    window.addEventListener('DOMContentLoaded', loadNeuralModel);
  </script>
</body>
